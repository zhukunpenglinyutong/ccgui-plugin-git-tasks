{
  "id": "github-tasks",
  "name": "CCGUI · Git 任务管理",
  "version": "0.2.1",
  "sdkVersion": ">=0.3.22",
  "minAppVersion": "1.1.8",
  "tier": "js",
  "author": "zhukunpenglinyutong",
  "license": "MIT",
  "repo": "zhukunpenglinyutong/ccgui-plugin-git-tasks",
  "description": "轻量 PR 流转看板：多仓库每日新增、我审没审、作者修没修、修完我看没看；看板拖拽只记本地标记；侧栏 worktree 显示 PR 状态。只读 gh CLI，不调用 AI、不写 GitHub。",
  "permissions": [
    "ui:center-tab",
    "ui:sidebar-entry",
    "ui:settings-section",
    "ui:command",
    "ui:worktree-badge",
    "storage",
    "host:workspace",
    "host:worktree",
    "exec:gh",
    "exec:git",
    "exec:open",
    "exec:xdg-open",
    "exec:cmd"
  ],
  "icon": "docs/icon.png",
  "screenshots": [
    "docs/screenshot-1.png",
    "docs/screenshot-2.png",
    "docs/screenshot-3.png",
    "docs/screenshot-4.png"
  ]
}
